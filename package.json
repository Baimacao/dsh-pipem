{
  "name": "dsh-pipem",
  "version": "0.1.0",
  "description": "哌甲酯（dsh-pipem）：DSH 插件。把犯过的错记成可检索的 guard，动手前查、报完成前绑证据；工具失败时自动提醒；长上下文下检测复读；内置 bash 工具与一颗心（宪章 + 心事本）。可替代 dsh-ops、dsh-scar、dsh-heart、dsh-gitbash-shell。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.0.1-rc.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "SETUP.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "lessons",
    "evidence",
    "memory",
    "heart",
    "persona"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baimacao/dsh-pipem.git"
  },
  "homepage": "https://github.com/Baimacao/dsh-pipem#readme",
  "bugs": {
    "url": "https://github.com/Baimacao/dsh-pipem/issues"
  },
  "author": "Baimacao"
}
